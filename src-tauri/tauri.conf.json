{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TaskSchdBackupRestore",
  "version": "1.2.0",
  "identifier": "fr.endymion.taskschdbackuprestore",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TaskSchdBackupRestore — Sauvegarde des tâches planifiées",
        "width": 1120,
        "height": 760,
        "minWidth": 860,
        "minHeight": 580,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}